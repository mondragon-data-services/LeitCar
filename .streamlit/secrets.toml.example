# Copie para .streamlit/secrets.toml. Nunca versione o arquivo real.

[connections.postgresql]
# Em Docker isso vem por DATABASE_URL e este bloco fica opcional.
url = "postgresql://lavacar:lavacar@localhost:5432/lavacar"

[admin]
senha = "troque-esta-senha"

[loja]
nome = "Leite Estética Automotiva"
telefone = "14999990000"   # PENDENCIA: telefone real do Leite
endereco = "Duartina - SP"
cidade = "Duartina"
chamada = "Lavagem, detalhamento e higienização com acabamento de loja especializada."
url_publica = "https://agendar.lavacar.com.br"
url_site = "https://lavacar.com.br"

# Sem este bloco (ou sem chave) o app nao cobra nada:
# o agendamento ja nasce confirmado e o cliente paga na entrega.
[pix]
chave = ""
nome = "LEITE ESTETICA AUTOMOTIVA"
cidade = "DUARTINA"
sinal_centavos = 2000
centavos_unicos = true
