# /etc/systemd/system/lavacar.service
# systemctl enable --now lavacar
[Unit]
Description=Lava Car Online (Streamlit)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=lavacar
WorkingDirectory=/opt/lavacar
Environment=TZ=America/Sao_Paulo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lavacar/.venv/bin/streamlit run app.py \
          --server.port 8501 \
          --server.address 127.0.0.1 \
          --server.headless true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
